<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Grasstube" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0&icon_names=add,check,close,close_fullscreen,drag_handle,edit,expand_less,expand_more,open_in_full,pause,play_arrow,refresh,settings,settings_backup_restore,skip_next,subtitles,subtitles_off,volume_down,volume_up"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body>
    <nav>
      <div>
        <.link navigate={~p"/"}>Index</.link>
        <%= if @current_scope.user do %>
          <.link href={~p"/user/settings"}>{@current_scope.user.username}</.link>
          <.link href={~p"/user/log-out"} method="delete">Log out</.link>
        <% else %>
          <.link href={~p"/user/register"}>Register</.link>
          <.link href={~p"/user/log-in"}>Log in</.link>
        <% end %>
      </div>
    </nav>
    <main>{@inner_content}</main>
  </body>
</html>
