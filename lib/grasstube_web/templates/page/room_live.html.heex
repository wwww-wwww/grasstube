<head>
<%= if @room == "jade room" do %>
  <link rel="icon" href="/static/yuri!!!.webp" type="image/webp">
<% end %>
</head>

<%= if @script do %>
<meta phx-update="ignore" id="room_script" name="room_script" content={@script}>
<% end %>

<meta name="robots" content="noindex">

<div phx-hook="room" id="maincontent">

<.live_component
  module={GrasstubeWeb.ChatComponent}
  id={"#{GrasstubeWeb.ChatComponent}:{@room}"}
  room={@room}
  chat={@chat}
  emotes={@emotes} />

<div id="chat_danmaku" phx-update="ignore"></div>

</div>

<div id="dragbar_v"></div>

<div id="bottom">

<div class="col">
  <div style="display: flex; gap: 0.5em;">
    <button id="btn_open_chat">Open chat</button>
    <button id="btn_user_settings">Settings</button>
  </div>

</div>

<div class="col">
</div>

</div>
